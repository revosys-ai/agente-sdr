      "parameters": {
        "jsCode": "const resposta = $('Processar Tags').item.json.resposta;\nfunction dividirResposta(texto) {\n    const delimitadores = new RegExp(`(?<!\\\\d|Av|Dr|Dra|Sr|Sra|Prof|R|Tel|No|Apto|Ed)\\\\.(?=\\\\s)|(?<=!\\\\s)|(?<=\\\\?\\\\s)`);\n    return texto.split(delimitadores)\n        .map(parte => parte.trim())\n        .filter(parte => parte.length > 0);\n}\nconst partesDivididas = dividirResposta(resposta);\nreturn { json: { responses: partesDivididas } };"
      },
