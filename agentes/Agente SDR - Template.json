      "id": "sdr-0043",
      "name": "Capturar Resposta"
    },
    {
      "parameters": {
        "jsCode": "const resposta = $input.first().json.resposta;\n\nconst qualificado = resposta.includes('[QUALIFICADO]');\nconst desqualificado = resposta.includes('[DESQUALIFICADO]');\nconst nomeMatch = resposta.match(/\\[NOME:([^\\]]+)\\]/);\nconst empresaMatch = resposta.match(/\\[EMPRESA:([^\\]]+)\\]/);\nconst cargoMatch = resposta.match(/\\[CARGO:([^\\]]+)\\]/);\n\nconst mensagemLimpa = resposta\n  .replace(/\\[QUALIFICADO\\]/g, '')\n  .replace(/\\[DESQUALIFICADO\\]/g, '')\n  .replace(/\\[NOME:[^\\]]*\\]/g, '')\n  .replace(/\\[EMPRESA:[^\\]]*\\]/g, '')\n  .replace(/\\[CARGO:[^\\]]*\\]/g, '')\n  .trim();\n\nconst acao = qualificado ? 'qualificado' : (desqualificado ? 'desqualificado' : 'continua');\n\nreturn [{\n  json: {\n    resposta: mensagemLimpa,\n    acao,\n    nome_extraido: nomeMatch ? nomeMatch[1].trim() : null,\n    empresa_extraida: empresaMatch ? empresaMatch[1].trim() : null,\n    cargo_extraido: cargoMatch ? cargoMatch[1].trim() : null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [6940, 380],
      "id": "sdr-0044",
      "name": "Processar Tags"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1},
                "conditions": [
                  {
                    "id": "sdr-rule-q1",
                    "leftValue": "={{ $json.acao }}",
                    "rightValue": "qualificado",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "qualificado"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1},
                "conditions": [
                  {
                    "id": "sdr-rule-q2",
                    "leftValue": "={{ $json.acao }}",
                    "rightValue": "desqualificado",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "desqualificado"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1},
                "conditions": [
                  {
                    "id": "sdr-rule-q3",
                    "leftValue": "={{ $json.acao }}",
                    "rightValue": "continua",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "continua"
            }
          ]
        },
        "options": {}
      },
